{
  "name": "agentic-u-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:landmines && pnpm env:check && pnpm lockfile:check",
    "format:check": "oxfmt --check package.json tsconfig.base.json oxlint.config.ts oxfmt.config.ts packages scripts",
    "typecheck": "pnpm --recursive --filter '!@agentic-u/fence' --filter '!@agentic-u/checkers' exec effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "pnpm --recursive --if-present check",
    "typecheck:parity": "pnpm --filter @agentic-u/checkers test",
    "test": "pnpm build && pnpm --recursive --if-present test && pnpm test:operational && python3 -m unittest discover -s tests -v",
    "test:operational": "node --test scripts/operational.test.mjs scripts/hooks/*.test.mjs",
    "check:landmines": "node scripts/check-landmines.mjs",
    "env:check": "varlock load",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "acceptance:cold-install": "node scripts/acceptance-cold-install.mjs",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "prepare": "effect-tsgo patch && lefthook install",
    "test:operations": "pnpm --filter @agentic-u/operations test",
    "test:fence": "pnpm --filter @agentic-u/fence test",
    "lint": "oxlint -c oxlint.config.ts packages/*/src packages/*/test scripts packages/checkers/compiler-parity.test.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@types/node": "24.19.2",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "4.1.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "varlock": "1.25.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.21.0"
}
